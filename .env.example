# copy this to .env (it's in .gitignore so it never gets committed)

# where the AI buyers come from (see docs/AI_SETUP.md):
#   ollama  = free, runs on your own computer
#   groq    = free online tier, needs GROQ_API_KEY
#   claude  = Anthropic's API, needs ANTHROPIC_API_KEY (paid)
#   bedrock = Claude on Amazon Bedrock, uses your AWS account (paid)
#   demo    = no AI, buyers are a simple rule-based practice bot
CALLCADE_MODE=demo

OLLAMA_MODEL=llama3.1:8b

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# groq    = Orpheus voices on Groq (free with your Groq key, very human, can sound annoyed or warm)
# polly   = Amazon Polly voices, a different one for every buyer (needs AWS)
# browser = the browser's built-in voices
CALLCADE_VOICE=groq

# email for verify + password reset links.
# leave SMTP_HOST empty and the links just print in the Terminal instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Callcade <no-reply@example.com>
SITE_URL=http://localhost:8000
